{
  "version": 2,
  "name": "employee-retention-prediction-system",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "reports/figures/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/reports/figures/(.*)",
      "dest": "reports/figures/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
